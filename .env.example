# ===================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO COZE AGENT
# ===================================================
# Sao chép file này thành .env và điền các giá trị thực tế:
# cp .env.example .env

# Cổng khởi chạy máy chủ (Mặc định: 3000 hoặc theo PORT của nhà cung cấp Cloud)
PORT=3000

# Coze Personal Access Token (PAT)
# Lấy tại: https://www.coze.com/open/api
COZE_API_KEY=pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Coze Bot ID
# Lấy số Bot ID từ URL trình duyệt khi mở bot trên Coze
COZE_BOT_ID=7xxxxxxxxxxxxxxxxxx
